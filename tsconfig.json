{
    "compilerOptions": {
          "target": "ES2022",
          "lib": ["dom", "dom.iterable", "esnext"],
          "allowJs": false,
          "skipLibCheck": true,
          "strict": true,
          "noEmit": true,
          "esModuleInterop": true,
          "module": "esnext",
          "moduleResolution": "bundler",
          "resolveJsonModule": true,
          "isolatedModules": true,
          "jsx": "react-jsx",
          "incremental": true,
          "plugins": [{ "name": "next" }],
          "paths": { "@/*": ["./*"] }
    },
    "include": [
          "next-env.d.ts",
          "**/*.ts",
          "**/*.tsx",
          ".next/types/**/*.ts",
          ".next/dev/types/**/*.ts"
    ],
    "exclude": [
          "node_modules",
          ".next",
          "AgentChat.tsx",
          "MenuPanel.tsx",
          "WalletOrders.tsx",
          "auth.ts",
          "campusbite.ts",
          "dates.ts",
          "defineTool.ts",
          "env.ts",
          "gemini.ts",
          "layout.tsx",
          "page.tsx",
          "route.ts",
          "runAgent.ts",
          "schemas.ts",
          "supabase.ts",
          "systemPrompt.ts",
          "tools.ts",
          "types.ts"
    ]
}
